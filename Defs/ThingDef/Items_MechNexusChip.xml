<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Mech nexus chip — self-installable mechanitor implant (Biotech pattern).
    Crafted at the machining table from all three mech-boss chips.
    RecipeDef is generated by recipeMaker (Make_EM_MechNexusChip).
  -->
  <ThingDef ParentName="MechanitorImplantCraftableBase">
    <defName>EM_MechNexusChip</defName>
    <label>mech nexus chip</label>
    <description>An archotech-grade mechanitor implant that fuses signal, powerfocus, and nanostructuring chip architectures into a single command nexus.\n\nEach install expands bandwidth, raises controlled-mech work efficiency, and accelerates mech repairs.\n\nAt the 3rd install, the nexus continuously recharges overseen mechanoids. At the 6th install, it also continuously mends their injuries — no recharger or manual repair required.\n\nThis implant can be self-installed without surgery. Only a mechanitor (someone with a mechlink) can install it.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <descriptionHyperlinks>
      <HediffDef>EM_MechNexusChipImplant</HediffDef>
    </descriptionHyperlinks>
    <costList>
      <SignalChip>1</SignalChip>
      <PowerfocusChip>1</PowerfocusChip>
      <NanostructuringChip>1</NanostructuringChip>
      <ComponentSpacer>4</ComponentSpacer>
      <Plasteel>20</Plasteel>
    </costList>
    <statBases>
      <MarketValue>3500</MarketValue>
      <MaxInstallCount>6</MaxInstallCount>
      <WorkToMake>8000</WorkToMake>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>UltraMechtech</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <displayPriority>700</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>Implant {0_label}</useLabel>
        <userMustHaveHediff>MechlinkImplant</userMustHaveHediff>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>EM_MechNexusChipImplant</hediffDef>
        <bodyPart>Brain</bodyPart>
        <canUpgrade>true</canUpgrade>
      </li>
    </comps>
  </ThingDef>

</Defs>
